# Bản 1-stage GỐC của lab — giữ lại chỉ để so sánh dung lượng (exercises.md câu 3):
#   docker build -f Dockerfile.single -t agent:single .
# Không dùng file này để deploy.

FROM python:3.11

WORKDIR /app

COPY . .

RUN pip install -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
